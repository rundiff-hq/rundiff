#!/usr/bin/env ruby
require "fileutils"
require "json"
require "optparse"
require_relative "../config/environment"

options = {}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/collect-production-proof OWNER/REPO --pull-request N [--output FILE]"

  opts.on("--pull-request N", Integer, "PR that transitions from BLOCK to ALLOW") do |value|
    options[:pull_request] = value
  end

  opts.on("--output FILE", String, "Write the evidence bundle to FILE") do |value|
    options[:output] = value
  end
end

parser.parse!

repository = ARGV.shift
if repository.to_s.empty? || !ARGV.empty? || !options[:pull_request]
  warn parser
  exit 64
end

begin
  bundle = RunDiff::Github::ProductionProofBundle.new(
    repository:,
    pull_request: options.fetch(:pull_request)
  ).call

  json = JSON.pretty_generate(bundle)
  puts json

  if options[:output]
    FileUtils.mkdir_p(File.dirname(File.expand_path(options.fetch(:output))))
    File.write(options.fetch(:output), "#{json}\n")
  end
rescue RunDiff::Github::ProductionProofBundle::Error,
  RunDiff::Github::AppAuthentication::Error,
  RunDiff::Github::ProofEvidenceClient::Error,
  KeyError,
  ArgumentError => error
  warn "production proof collection failed: #{error.message}"
  exit 1
end
