#!/usr/bin/env bash
set -Eeuo pipefail

# Provider-neutral control-plane process entrypoint.
# The platform supplies DATABASE_URL, PORT and the RunDiff runtime environment.
#
# Deployment targets can provide either the exact execution endpoint, a public
# executor origin, or a private host:port. Normalize the generic forms here
# without leaking a provider name into the application runtime contract.
if [[ -z "${RUNDIFF_REMOTE_EXECUTOR_URL:-}" && -n "${RUNDIFF_REMOTE_EXECUTOR_ORIGIN:-}" ]]; then
  export RUNDIFF_REMOTE_EXECUTOR_URL="${RUNDIFF_REMOTE_EXECUTOR_ORIGIN%/}/v1/executions"
elif [[ -z "${RUNDIFF_REMOTE_EXECUTOR_URL:-}" && -n "${RUNDIFF_REMOTE_EXECUTOR_HOSTPORT:-}" ]]; then
  export RUNDIFF_REMOTE_EXECUTOR_URL="http://${RUNDIFF_REMOTE_EXECUTOR_HOSTPORT}/v1/executions"
fi

bin/rails db:prepare

# Prepare the queue schema through the configured production queue connection.
# This stays idempotent for both shared-database proof targets and separate
# queue-database production targets, without invoking test-database Rake tasks.
bin/prepare-solid-queue

# The first production proof keeps Solid Queue in the same service/container.
# Dedicated worker processes remain a deployment-target choice.
bin/jobs &

exec bin/rails server -b 0.0.0.0 -p "${PORT:-3000}"
