#!/usr/bin/env ruby

require_relative "../config/environment"
require "active_record/tasks/database_tasks"

db_config = ActiveRecord::Base.configurations.configs_for(
  env_name: Rails.env,
  name: "queue"
)

abort "queue database configuration is missing" unless db_config

schema = Rails.root.join("db/queue_schema.rb").to_s
tasks = ActiveRecord::Tasks::DatabaseTasks
status = "ready"

tasks.with_temporary_connection(db_config) do |connection|
  unless connection.data_source_exists?("solid_queue_jobs")
    tasks.load_schema(db_config, :ruby, schema)
    connection.schema_cache.clear!

    abort "Solid Queue schema load did not create solid_queue_jobs" unless connection.data_source_exists?("solid_queue_jobs")
    status = "loaded"
  end
end

puts "solid_queue_schema=#{status}"
