#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

ENVIRONMENT="${1:-development}"
case "$ENVIRONMENT" in
  development|dev)
    ENVIRONMENT="development"
    DEFAULT_PUBLIC_URL="https://github-dev.flowato.dev"
    RAILS_ENVIRONMENT="development"
    ;;
  staging|stage|stg)
    ENVIRONMENT="staging"
    DEFAULT_PUBLIC_URL="https://github-staging.flowato.dev"
    RAILS_ENVIRONMENT="production"
    ;;
  production|prod)
    ENVIRONMENT="production"
    DEFAULT_PUBLIC_URL="https://github.flowato.dev"
    RAILS_ENVIRONMENT="production"
    ;;
  *)
    printf 'Unknown environment: %s\n' "$ENVIRONMENT" >&2
    exit 1
    ;;
esac

ENV_FILE="tmp/github-app/${ENVIRONMENT}.env"
[[ -f "$ENV_FILE" ]] || { printf 'Missing credentials: %s\n' "$ENV_FILE" >&2; exit 1; }

SECRET_LINES="$(grep -Ec '^(export )?RUNDIFF_GITHUB_WEBHOOK_SECRET=' "$ENV_FILE" || true)"
[[ "$SECRET_LINES" == "1" ]] || {
  printf 'Expected exactly one RUNDIFF_GITHUB_WEBHOOK_SECRET in %s, found %s\n' "$ENV_FILE" "$SECRET_LINES" >&2
  exit 1
}

# shellcheck disable=SC1090
source "$ENV_FILE"

export RUNDIFF_PUBLIC_URL="${RUNDIFF_PUBLIC_URL:-$DEFAULT_PUBLIC_URL}"
export RAILS_ENV="$RAILS_ENVIRONMENT"

mise exec -- bin/rails runner '
authentication = RunDiff::Github::AppAuthentication.from_env(root: Rails.root)
result = authentication.sync_webhook!(
  url: "#{ENV.fetch("RUNDIFF_PUBLIC_URL")}/github/webhooks",
  secret: ENV.fetch("RUNDIFF_GITHUB_WEBHOOK_SECRET")
)

puts "GitHub App webhook synced"
puts "URL: #{result.fetch("url")}"
puts "Content-Type: #{result.fetch("content_type")}"
'
