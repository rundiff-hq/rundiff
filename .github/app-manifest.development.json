{
  "name": "RunDiff Development",
  "description": "Development GitHub App for RunDiff behavioral change validation.",
  "url": "https://github.com/rundiff-hq/rundiff",
  "hook_attributes": {
    "url": "{{PLYWO_PUBLIC_URL}}/github/webhooks",
    "active": true
  },
  "redirect_url": "{{PLYWO_PUBLIC_URL}}/github/app/manifest/callback",
  "setup_url": "{{PLYWO_PUBLIC_URL}}/onboarding",
  "public": false,
  "default_permissions": {
    "checks": "write",
    "contents": "read",
    "pull_requests": "write"
  },
  "default_events": [
    "pull_request",
    "check_run"
  ],
  "request_oauth_on_install": false,
  "setup_on_update": true
}
