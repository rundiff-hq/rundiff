{
  "name": "RunDiff Checks",
  "description": "Know what changed before you merge.",
  "url": "https://rundiff.com",
  "hook_attributes": {
    "url": "{{RUNDIFF_PUBLIC_URL}}/api/github/webhooks",
    "active": true
  },
  "public": true,
  "default_permissions": {
    "checks": "write",
    "contents": "read",
    "pull_requests": "write"
  },
  "default_events": [
    "pull_request",
    "check_run"
  ],
  "request_oauth_on_install": false
}
