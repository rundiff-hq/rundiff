RAILS_ENV=production
SECRET_KEY_BASE=
RUNDIFF_RUNTIME_ROLE=control_plane
DATABASE_URL=postgres://USER:PASSWORD@DB_HOST:5432/rundiff_control_plane

RUNDIFF_PUBLIC_URL=https://app.rundiff.com
RUNDIFF_GITHUB_APP_MANIFEST_ENV=production
RUNDIFF_GITHUB_APP_SLUG=rundiff
RUNDIFF_GITHUB_APP_ID=
RUNDIFF_GITHUB_CLIENT_ID=
RUNDIFF_GITHUB_WEBHOOK_SECRET=
RUNDIFF_GITHUB_PRIVATE_KEY_PATH=/run/secrets/rundiff-github-private-key.pem
RUNDIFF_GITHUB_APP_CHECK_NAME=RunDiff / Behavioral Diff
RUNDIFF_GITHUB_APP_BOT_LOGIN=rundiff[bot]

# Temporary public-App safety gate until disposable managed executors are available.
# Use exact GitHub repository full names only. Wildcard * is rejected in production.
RUNDIFF_GITHUB_REPOSITORY_ALLOWLIST=external-owner/proof-repository

# Bootstrap only: set to 1 before the production GitHub App is registered.
# Remove or set back to 0 immediately after credentials are captured.
RUNDIFF_ENABLE_GITHUB_APP_REGISTRATION=0

RUNDIFF_EXECUTOR=remote
RUNDIFF_REMOTE_EXECUTOR_URL=https://executor.rundiff.com
RUNDIFF_REMOTE_EXECUTOR_TOKEN=
RUNDIFF_REMOTE_EXECUTOR_OPEN_TIMEOUT_SECONDS=5
RUNDIFF_REMOTE_EXECUTOR_READ_TIMEOUT_SECONDS=2100

RUNDIFF_EXECUTION_LEASE_SECONDS=1800
RUNDIFF_EXECUTION_HEARTBEAT_INTERVAL_SECONDS=600
