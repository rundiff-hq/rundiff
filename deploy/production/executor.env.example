RAILS_ENV=production
SECRET_KEY_BASE=
RUNDIFF_RUNTIME_ROLE=executor_service
DATABASE_URL=postgres://rundiff:CHANGE_ME@postgres:5432/rundiff_executor

RUNDIFF_EXECUTOR_SERVICE_TOKEN=
RUNDIFF_EXECUTOR_SERVICE_ADAPTER=git_clone
RUNDIFF_EXECUTOR_SERVICE_REQUEST_LEASE_SECONDS=2400

# PostgreSQL authority used for disposable customer subject databases.
RUNDIFF_LOCAL_POSTGRES_URL=postgres://rundiff:CHANGE_ME@postgres:5432

# These must remain unset on the executor:
# RUNDIFF_GITHUB_PRIVATE_KEY_PATH
# RUNDIFF_GITHUB_WEBHOOK_SECRET
# RUNDIFF_REMOTE_EXECUTOR_URL
# RUNDIFF_REMOTE_EXECUTOR_TOKEN
# RUNDIFF_EXECUTOR=remote
