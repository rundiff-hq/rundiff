DATABASE_URL=postgres://localhost/rundiff_development
# Legacy PLYWO_* names are retained during the compatibility migration.\nPLYWO_EXECUTION_ID=
PLYWO_RUN_ID=

# Runtime role
# Development/test default to combined. Production defaults to control_plane.
# Use executor_service for the isolated remote executor deployment.
PLYWO_RUNTIME_ROLE=

# GitHub App bootstrap/runtime - control-plane role only
PLYWO_PUBLIC_URL=
PLYWO_GITHUB_APP_OWNER=rundiff-hq
PLYWO_GITHUB_APP_MANIFEST_ENV=development
PLYWO_GITHUB_APP_ID=
PLYWO_GITHUB_CLIENT_ID=
PLYWO_GITHUB_WEBHOOK_SECRET=
PLYWO_GITHUB_PRIVATE_KEY_PATH=tmp/github-app/plywo-development.pem
# Optional in development/test. Required and fail-closed in production until disposable managed executors exist.
# Exact comma-separated repository.full_name values only; wildcard * is rejected in production.
PLYWO_GITHUB_REPOSITORY_ALLOWLIST=

# Execution backend
# Development defaults to authenticated git-clone execution so installed repositories work out of the box.
# Use local explicitly only for self-repo exact-worktree development.
# Production control plane must use remote.
PLYWO_EXECUTOR=git_clone
# Compatibility fallback while existing local setups migrate:
# PLYWO_GITHUB_EXECUTION_MODE=local
PLYWO_LOCAL_POSTGRES_URL=postgres://localhost
# A claimed execution must finalize before this lease expires unless it is renewed.
PLYWO_EXECUTION_LEASE_SECONDS=1800
# Defaults to one third of the execution lease and must remain shorter than the lease.
PLYWO_EXECUTION_HEARTBEAT_INTERVAL_SECONDS=600

# Remote execution backend used by the control-plane role.
# Set PLYWO_EXECUTOR=remote and point this at a trusted HTTPS executor endpoint.
PLYWO_REMOTE_EXECUTOR_URL=
PLYWO_REMOTE_EXECUTOR_TOKEN=
PLYWO_REMOTE_EXECUTOR_OPEN_TIMEOUT_SECONDS=5
PLYWO_REMOTE_EXECUTOR_READ_TIMEOUT_SECONDS=2100

# Executor service role. Do not deploy GitHub App private keys or webhook secrets into this role.
# PLYWO_EXECUTOR_SERVICE=1 remains a compatibility signal; prefer PLYWO_RUNTIME_ROLE=executor_service.
PLYWO_EXECUTOR_SERVICE=0
PLYWO_EXECUTOR_SERVICE_TOKEN=
# local = development only; production readiness requires git_clone.
PLYWO_EXECUTOR_SERVICE_ADAPTER=local
PLYWO_EXECUTOR_SERVICE_REQUEST_LEASE_SECONDS=2400

# GitHub App publication - control-plane role only
PLYWO_GITHUB_APP_CHECK_NAME=RunDiff Development / Behavioral Diff
PLYWO_GITHUB_APP_BOT_LOGIN=plywo-development[bot]
