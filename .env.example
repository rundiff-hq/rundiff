DATABASE_URL=postgres://localhost/rundiff_development
RUNDIFF_EXECUTION_ID=
RUNDIFF_RUN_ID=

# Runtime role
# Development/test default to combined. Production defaults to control_plane.
# Use executor_service for the isolated remote executor deployment.
RUNDIFF_RUNTIME_ROLE=

# GitHub App bootstrap/runtime - control-plane role only
RUNDIFF_PUBLIC_URL=
RUNDIFF_GITHUB_APP_OWNER=rundiff-hq
RUNDIFF_GITHUB_APP_MANIFEST_ENV=development
RUNDIFF_GITHUB_APP_ID=
RUNDIFF_GITHUB_CLIENT_ID=
RUNDIFF_GITHUB_WEBHOOK_SECRET=
RUNDIFF_GITHUB_PRIVATE_KEY_PATH=tmp/github-app/rundiff-development.pem
# Optional in development/test. Required and fail-closed in production until disposable managed executors exist.
# Exact comma-separated repository.full_name values only; wildcard * is rejected in production.
RUNDIFF_GITHUB_REPOSITORY_ALLOWLIST=

# Execution backend
# Development defaults to authenticated git-clone execution so installed repositories work out of the box.
# Use local explicitly only for self-repo exact-worktree development.
# Production control plane must use remote.
RUNDIFF_EXECUTOR=git_clone
RUNDIFF_LOCAL_POSTGRES_URL=postgres://localhost
# A claimed execution must finalize before this lease expires unless it is renewed.
RUNDIFF_EXECUTION_LEASE_SECONDS=1800
# Defaults to one third of the execution lease and must remain shorter than the lease.
RUNDIFF_EXECUTION_HEARTBEAT_INTERVAL_SECONDS=600

# Remote execution backend used by the control-plane role.
# Set RUNDIFF_EXECUTOR=remote and point this at a trusted HTTPS executor endpoint.
RUNDIFF_REMOTE_EXECUTOR_URL=
RUNDIFF_REMOTE_EXECUTOR_TOKEN=
RUNDIFF_REMOTE_EXECUTOR_OPEN_TIMEOUT_SECONDS=5
RUNDIFF_REMOTE_EXECUTOR_READ_TIMEOUT_SECONDS=2100

# Executor service role. Do not deploy GitHub App private keys or webhook secrets into this role.
# Use RUNDIFF_RUNTIME_ROLE=executor_service for the executor service role.
RUNDIFF_EXECUTOR_SERVICE=0
RUNDIFF_EXECUTOR_SERVICE_TOKEN=
# local = development only; production readiness requires git_clone.
RUNDIFF_EXECUTOR_SERVICE_ADAPTER=local
RUNDIFF_EXECUTOR_SERVICE_REQUEST_LEASE_SECONDS=2400

# GitHub App publication - control-plane role only
RUNDIFF_GITHUB_APP_CHECK_NAME=RunDiff / Behavioral Review
RUNDIFF_GITHUB_APP_BOT_LOGIN=rundiff-development[bot]
