{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rundiff.dev/schemas/comparison-v1.schema.json",
  "title": "RunDiff Comparison v1",
  "type": "object",
  "required": ["schema_version", "baseline", "candidates", "ranking"],
  "properties": {
    "schema_version": { "const": "1" },
    "baseline": {
      "type": "object",
      "required": ["id", "measurements"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "measurements": { "type": "object" }
      },
      "additionalProperties": true
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "measurements", "result"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "measurements": { "type": "object" },
          "result": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "ranking": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
